<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 配信データ（cdn.ton-soku.com）の取得に要る。Flutter のテンプレートは debug /
         profile の manifest にしか INTERNET を置かないので、ここに書かないと
         **release ビルドだけ**が全通信に失敗する。`flutter run`（debug）では再現しない
         （gyumesy-frontend-app と同じ） -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- マップの「現在地」（geolocator）。許可を求めるのは「現在地」を押した時だけ
         （lib/features/map/data/location_repository.dart）。**COARSE も置く** ——
         Android 12 以降は利用者が「おおよその位置」だけを許可でき、その時に
         FINE しか宣言していないと許可の画面が出ない -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- Android 13 以降は通知の表示に実行時の許可が要る。**宣言が無いと
         許可を求めるダイアログ自体が出ない**（拒否として即座に返る。gyumesy と同じ） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <application
        android:label="とん速"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- **Flutter 自身のディープリンク処理を切る**（gyumesy と同じ）。
                 宣言が無い時の既定は**有効**で、intent の URL を**そのまま
                 go_router へ渡す**。アプリは受け口を `deepLinkTarget` に
                 一本化している（`app.dart`）ので、両方が動くと 1 本のリンクが
                 2 回処理され、あちらが後に来て勝つ（gyumesy の実測: ロケール
                 付きの URL が「Page Not Found」で行き止まり。背面で落とされた
                 後は前に踏んだリンクが開く）。

                 **iOS 側の同じ設定は `ios/Runner/Info.plist`。** 片方だけ切ると
                 OS で挙動が割れる -->
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="false"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- **App Links（iOS のユニバーサルリンクに相当）。** Chrome や LINE で
                 ton-soku.com のリンクを押した時にブラウザではなくアプリを開く
                 （gyumesy-frontend-app の intent-filter を写し、名乗る面をとん速の
                 `deepLinkTarget` に合わせ直した）。

                 **`autoVerify="true"` が要になる。** これが無いと「アプリで開くか」
                 の選択ダイアログが毎回出る（＝既定でブラウザに負ける）。true だと
                 OS が `https://ton-soku.com/.well-known/assetlinks.json` を取りに行き、
                 署名の指紋が一致した時だけ既定でアプリを開く。

                 **web 側に assetlinks.json が要る。** iOS の
                 apple-app-site-association と対で、片側だけでは成立しない
                 （中身と置き方は `docs/deep-links.md`）。

                 受け口は `deepLinkTarget`（通知のタップと同じ関数に合流させる） -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <!-- **`deepLinkTarget` がアプリ内で開ける面だけを名乗る。**
                     パスを絞らないと `https://ton-soku.com/` 配下の全 URL を奪う。
                     名乗るのはホーム・記事一覧・記事・クーポン・カレンダー・
                     ランキング・通知設定。**`/about`・`/legal/*`・`/category/*` は
                     名乗らない**（アプリに画面が無い。とん速のホームにはカテゴリの
                     タブが無いので、gyumesy と違ってカテゴリも外す）。

                     **開けない面を名乗ってはいけない。** `deepLinkTarget` が
                     null を返す面を `launchUrl` で外部ブラウザへ逃がすと、**その
                     ACTION_VIEW を解決するのは「検証済みの App Links 持ち」＝
                     自分自身**なので、リンクが自分へ戻ってくる。戻ってきたものを
                     また逃がして、**際限なく往復する**（gyumesy の実測: 受け皿が
                     無かった頃の `/category/` は、1 回踏むと 2000 回超の自己起動で
                     ANR、端末の WindowManager ごと固まった）。
                     **開ける面を増やすか、名乗るのをやめるかの二択**で、
                     「名乗ったまま逃がす」だけは成り立たない。

                     ロケール別（`/en/`, `/zh/`）も同じ規則で並べる。

                     **末尾スラッシュの有無で 2 本並べる。** `android:path` は
                     完全一致（`PatternMatcher` の `PATTERN_LITERAL`）なので、
                     `/calendar` と `/calendar/` は別物。web の AASA も 2 つ列挙する。

                     **`pathPattern` で 1 本にまとめようとしないこと**（gyumesy が
                     2 回失敗した）。`?` は特別文字ではなくリテラル（`/calendar/?` は
                     文字列 `/calendar/?` にしか当たらない）。`*` は「直前の 1 文字の
                     0 回以上」だが、**効くのは照合文字列が残っている間だけ**で、
                     `/calendar/*` は `/calendar/` には当たっても `/calendar` には
                     当たらない。`.*` なら両方拾えるが **`/calendarium` まで拾う**。

                     **記事は `pathPrefix` ではなく `pathPattern` の `..*`。**
                     `pathPrefix` は前方一致の 1 行なので `/articles/` の後ろに何が
                     来ても名乗る。`..*` は「任意の 1 文字 ＋ 0 回以上」なので slug が
                     要る（slug の無い `/articles` `/articles/` は記事一覧として
                     別に名乗っている）。

                     **残っている穴:** `..*` は `/` も拾うので、`/articles/x/y/` の
                     ような**web に無い深さ**も名乗ってしまう（`deepLinkTarget` は
                     開けない）。web がそういう URL を出さない限り踏まれないが、
                     踏まれると上の往復に落ちる。`pathPattern` では「`/` 以外」を
                     書けない（gyumesy も同じ形で出している）。

                     **名乗る範囲と `deepLinkTarget` のずれは
                     `test/features/notifications/deep_link_test.dart` が
                     止める**（このファイルを読んで、名乗った面が全部
                     開けることを確かめている）。

                     **この形の誤りはビルドも analyze も通る。** 実機で
                     `adb shell am start -a android.intent.action.VIEW -d "<url>"`
                     を踏んで確かめること -->
                <data android:scheme="https" android:host="ton-soku.com" android:path="/"/>
                <data android:scheme="https" android:host="ton-soku.com" android:path="/articles"/>
                <data android:scheme="https" android:host="ton-soku.com" android:path="/articles/"/>
                <data android:scheme="https" android:host="ton-soku.com" android:path="/coupon"/>
                <data android:scheme="https" android:host="ton-soku.com" android:path="/coupon/"/>
                <data android:scheme="https" android:host="ton-soku.com" android:path="/calendar"/>
                <data android:scheme="https" android:host="ton-soku.com" android:path="/calendar/"/>
                <data android:scheme="https" android:host="ton-soku.com" android:path="/ranking"/>
                <data android:scheme="https" android:host="ton-soku.com" android:path="/ranking/"/>
                <data android:scheme="https" android:host="ton-soku.com" android:path="/notifications"/>
                <data android:scheme="https" android:host="ton-soku.com" android:path="/notifications/"/>
                <data android:scheme="https" android:host="ton-soku.com" android:pathPattern="/articles/..*"/>
                <data android:scheme="https" android:host="ton-soku.com" android:path="/en"/>
                <data android:scheme="https" android:host="ton-soku.com" android:path="/en/"/>
                <data android:scheme="https" android:host="ton-soku.com" android:path="/en/articles"/>
                <data android:scheme="https" android:host="ton-soku.com" android:path="/en/articles/"/>
                <data android:scheme="https" android:host="ton-soku.com" android:path="/en/coupon"/>
                <data android:scheme="https" android:host="ton-soku.com" android:path="/en/coupon/"/>
                <data android:scheme="https" android:host="ton-soku.com" android:path="/en/calendar"/>
                <data android:scheme="https" android:host="ton-soku.com" android:path="/en/calendar/"/>
                <data android:scheme="https" android:host="ton-soku.com" android:path="/en/ranking"/>
                <data android:scheme="https" android:host="ton-soku.com" android:path="/en/ranking/"/>
                <data android:scheme="https" android:host="ton-soku.com" android:path="/en/notifications"/>
                <data android:scheme="https" android:host="ton-soku.com" android:path="/en/notifications/"/>
                <data android:scheme="https" android:host="ton-soku.com" android:pathPattern="/en/articles/..*"/>
                <data android:scheme="https" android:host="ton-soku.com" android:path="/zh"/>
                <data android:scheme="https" android:host="ton-soku.com" android:path="/zh/"/>
                <data android:scheme="https" android:host="ton-soku.com" android:path="/zh/articles"/>
                <data android:scheme="https" android:host="ton-soku.com" android:path="/zh/articles/"/>
                <data android:scheme="https" android:host="ton-soku.com" android:path="/zh/coupon"/>
                <data android:scheme="https" android:host="ton-soku.com" android:path="/zh/coupon/"/>
                <data android:scheme="https" android:host="ton-soku.com" android:path="/zh/calendar"/>
                <data android:scheme="https" android:host="ton-soku.com" android:path="/zh/calendar/"/>
                <data android:scheme="https" android:host="ton-soku.com" android:path="/zh/ranking"/>
                <data android:scheme="https" android:host="ton-soku.com" android:path="/zh/ranking/"/>
                <data android:scheme="https" android:host="ton-soku.com" android:path="/zh/notifications"/>
                <data android:scheme="https" android:host="ton-soku.com" android:path="/zh/notifications/"/>
                <data android:scheme="https" android:host="ton-soku.com" android:pathPattern="/zh/articles/..*"/>
            </intent-filter>
        </activity>
        <!-- **背面に居る時、通知は FCM が自分で出す。** その時に使うアイコン・色・
             チャンネル（gyumesy-frontend-app と同じ組み）。

             **アイコンはランチャーアイコンを指さない。** 指定しないとランチャー
             アイコンが使われるが、**カラーのアイコンは不透明なので全面が塗り潰されて
             白い四角になる**（Android は小アイコンをアルファのマスクとしてしか見ない。
             gyumesy が踏んだ）。素材は `tool/build_notification_icon.py` が web の
             badge.png から作る。**`push_bootstrap.dart` の `_smallIcon` と同じ絵**
             ——ずれると前面と背面で違う絵が出る。

             **チャンネル ID は `push_bootstrap.dart` の `_channel` と同じにすること**
             ——ずれると前面と背面で別チャンネル扱いになり、端末側のオン・オフが
             2 つに割れる。**送る側（tonsoku-backend-batch の `app/notify/push.py`）は
             チャンネル・アイコン・色を指定しない**約束で、ここが既定を持つ -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_color" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="tonsoku_default" />
        <!-- AdMob のアプリ ID。**いまは Google 公式のテスト用の値**
             （https://developers.google.com/admob/android/test-ads ）。**リリース前に
             AdMob で作った Android アプリの ID（ca-app-pub-…~…）に差し替える。**
             無いと SDK が起動時に落ちるので、広告の枠が全部空の間も置いておく。
             広告ユニット ID は lib/core/config/ad_config.dart -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713"/>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
