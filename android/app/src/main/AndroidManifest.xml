<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 配信データ（cdn.ton-soku.com）の取得に要る。Flutter のテンプレートは debug /
         profile の manifest にしか INTERNET を置かないので、ここに書かないと
         **release ビルドだけ**が全通信に失敗する。`flutter run`（debug）では再現しない
         （gyumesy-frontend-app と同じ） -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- マップの「現在地」（geolocator）。許可を求めるのは「現在地」を押した時だけ
         （lib/features/map/data/location_repository.dart）。**COARSE も置く** ——
         Android 12 以降は利用者が「おおよその位置」だけを許可でき、その時に
         FINE しか宣言していないと許可の画面が出ない -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- Android 13 以降は通知の表示に実行時の許可が要る。**宣言が無いと
         許可を求めるダイアログ自体が出ない**（拒否として即座に返る。gyumesy と同じ） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <application
        android:label="とん速"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- **Flutter 自身のディープリンク処理を切る**（gyumesy と同じ）。
                 宣言が無い時の既定は**有効**で、intent の URL を**そのまま
                 go_router へ渡す**。アプリは受け口を `deepLinkTarget` に
                 一本化している（`app.dart`）ので、両方が動くと 1 本のリンクが
                 2 回処理され、あちらが後に来て勝つ（gyumesy の実測: ロケール
                 付きの URL が「Page Not Found」で行き止まり。背面で落とされた
                 後は前に踏んだリンクが開く）。

                 **App Links の intent-filter はまだ置かない**（リリース整備の
                 Issue #9 で web の assetlinks.json と対にして足す）。足す時は
                 **`deepLinkTarget` が開ける面だけを名乗ること**（開けない面を
                 名乗ると、外部ブラウザへ逃がした 1 本が自分へ戻って際限なく
                 往復する。`test/features/notifications/deep_link_test.dart` が
                 止める）。**iOS 側の同じ設定は `ios/Runner/Info.plist`** -->
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="false"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- **背面に居る時、通知は FCM が自分で出す。** その時に使うアイコン・色・
             チャンネル（gyumesy-frontend-app と同じ組み）。

             **アイコンはランチャーアイコンを指さない。** 指定しないとランチャー
             アイコンが使われるが、**カラーのアイコンは不透明なので全面が塗り潰されて
             白い四角になる**（Android は小アイコンをアルファのマスクとしてしか見ない。
             gyumesy が踏んだ）。素材は `tool/build_notification_icon.py` が web の
             badge.png から作る。**`push_bootstrap.dart` の `_smallIcon` と同じ絵**
             ——ずれると前面と背面で違う絵が出る。

             **チャンネル ID は `push_bootstrap.dart` の `_channel` と同じにすること**
             ——ずれると前面と背面で別チャンネル扱いになり、端末側のオン・オフが
             2 つに割れる。**送る側（tonsoku-backend-batch の `app/notify/push.py`）は
             チャンネル・アイコン・色を指定しない**約束で、ここが既定を持つ -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_color" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="tonsoku_default" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
